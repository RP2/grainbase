root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Rust / TOML: 4-space indent (matches rustfmt defaults for edition 2024).
[*.rs]
indent_size = 4

[*.toml]
indent_size = 4

# YAML: 2-space is the GitHub Actions convention.
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false  # Hard line breaks are meaningful in Markdown.

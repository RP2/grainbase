#!/bin/sh
# pre-push hook: mirror the CI "check" recipe plus supply-chain scan.
# cargo-deny is optional — skip gracefully when it is not on PATH.
set -e

GIT_ROOT="$(git rev-parse --show-toplevel)"
cd "$GIT_ROOT"

# Strict lints + tests. This is the same surface `just check` covers.
cargo clippy --workspace --all-targets --all-features
cargo test --workspace

# Supply-chain scan. Only if cargo-deny is installed; do not fail the push
# when an agent or developer has not installed it yet.
if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny check
else
    echo "note: cargo-deny not installed, skipping supply-chain check" >&2
fi

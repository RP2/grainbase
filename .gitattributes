# Normalize text files; declare fixtures and binaries as non-diffable.
# * text=auto defers per-file decisions to git's heuristics, then `eol=lf`
# forces a consistent line ending regardless of platform checkout behavior.
* text=auto eol=lf

# Raw and raster fixture formats — large, opaque, and not human-diffable.
*.arw  binary
*.dng  binary
*.cr2  binary
*.nef  binary
*.tif  binary
*.tiff binary
*.png  binary
*.jpg  binary
*.webp binary

# Cargo metadata — generated by cargo. Keep linguist out of stats noise.
Cargo.lock linguist-generated
